{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "SteamOS",
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2
    },
    "color": {
      "1": "#58a6ff",
      "2": "#bc63ff"
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "showPeCoreCount": true,
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "│ ├",
      "detectionMethod": "pci",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "│ ├󱄄",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "│ ├",
      "keyColor": "green"
    },
    {
      "type": "swap",
      "key": "└ └󰓡",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "command",
      "key": " OS",
      "keyColor": "blue",
      "text": ". /etc/os-release && echo \"CachyOS x86_64\""
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "│ ├",
      "keyColor": "blue"
    },
    {
      "type": "command",
      "key": "│ ├󰉼",
      "keyColor": "blue",
      "text": "pacman -Q noctalia 2>/dev/null | awk '{print \"Noctalia\", $2}' || echo 'not installed'"
    },
    {
      "type": "terminal",
      "key": "│ ├",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "blue"
    },
    {
      "type": "command",
      "key": "│ ├󰸌",
      "keyColor": "blue",
      "text": "scheme=$(noctalia msg color-scheme-get 2>/dev/null | awk '{print $2, $3}'); echo -e \"$scheme \\e[38m●\\e[37m●\\e[36m●\\e[35m●\\e[34m●\\e[33m●\\e[32m●\\e[31m●\""
    },
    {
      "type": "command",
      "key": "└ └",
      "keyColor": "blue",
      "text": "awk -v ORS=' ' '/^font_family/ {gsub(/^[ \\t]*font_family[ \\t]*/,\"\"); f=$0} /^font_size/ {s=$2} END {cmd=\"fc-match \\\"\" f \"\\\" -f %{style}\"; cmd | getline style; close(cmd); print f \" (\" s+0 \"pt, \" style \")\"}' ~/.config/kitty/kitty.conf"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────Age / Uptime────────────────────┐"
    },
    {
      "type": "command",
      "key": "󱦟 OS Age",
      "keyColor": "magenta",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },
    {
      "type": "uptime",
      "key": "󱫐 Uptime",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    }
  ],
  "display": {
    "color": {
      "keys": "#58a6ff",
      "title": "#bc8cff"
    },
    "percent": {
      "color": {
        "green": "#bc8cff",
        "yellow": "#80bbff",
        "red": "#f85149"
      }
    }
  }
}
